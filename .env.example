# Path to the input CSV dataset
DATA_PATH=notebooks/kaggle/breast-cancer.csv
# Path where the fitted pipeline artifact is saved
MODEL_PATH=models/model_pipeline.joblib
# Path where the selected feature names and order are saved
SELECTED_FEATURES_PATH=models/selected_features.json
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Application environment: development, production
ENVIRONMENT=development
# Fraction of the dataset held out for testing
TEST_SIZE=0.2
# Random seed for the split, SMOTETomek and feature selection
RANDOM_STATE=42
# Base URL of the FastAPI service (Streamlit only)
API_URL=http://localhost:8000
